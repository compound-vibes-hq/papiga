rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Podatki enega otroka. Ime dokumenta je skrivna koda (12 znakov); seznama kod ni mogoče prebrati.
    match /otroci/{koda} {
      allow get: if request.auth != null;
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && koda.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['json', 'v', 't'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 800000;
      // Glasovni posnetki besed.
      match /posnetki/{id} {
        allow get: if request.auth != null;
        allow list, delete: if false;
        allow create, update: if request.auth != null
          && koda.matches('^[A-HJ-NP-Z2-9]{12}$')
          && request.resource.data.keys().hasOnly(['w', 'data', 't'])
          && request.resource.data.w is string && request.resource.data.w.size() <= 600
          && request.resource.data.data is string && request.resource.data.data.size() < 950000;
      }
    }
  }
}
